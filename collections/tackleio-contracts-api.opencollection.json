{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tackle Public Authentication Contracts API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Contracts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List contracts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://contracts.tackle.io/api/contracts",
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "Opaque pagination cursor returned as `next` from a previous call."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of contracts to return per page. Defaults to 25, capped at 100."
              }
            ]
          },
          "docs": "Returns a paginated list of contracts available to your account.\n"
        },
        {
          "info": {
            "name": "Describe contract",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://contracts.tackle.io/api/contracts/:contractId",
            "params": [
              {
                "name": "contractId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns details for the contract identified by `contractId`. Returns\n`404` when no contract is found for that id.\n"
        }
      ]
    }
  ],
  "bundled": true
}