{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tackle Public Contracts Authentication Subscriptions API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Subscriptions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Subscriptions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://contracts.tackle.io/v1/subscriptions",
            "params": [
              {
                "name": "productid",
                "value": "",
                "type": "query",
                "description": "Product ID for a query"
              },
              {
                "name": "customerid",
                "value": "",
                "type": "query",
                "description": "Customer ID for a query"
              },
              {
                "name": "clouds",
                "value": "",
                "type": "query",
                "description": "Cloud for a query"
              },
              {
                "name": "start_date",
                "value": "",
                "type": "query",
                "description": "Start date for subscription query"
              },
              {
                "name": "end_date",
                "value": "",
                "type": "query",
                "description": "End date for subscription query"
              }
            ]
          },
          "docs": "List all subscriptions, optionally filtered by search criteria"
        },
        {
          "info": {
            "name": "Get a Subscription",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://contracts.tackle.io/v1/subscriptions/:tackle_subscription_id",
            "params": [
              {
                "name": "tackle_subscription_id",
                "value": "",
                "type": "path",
                "description": "Subscription ID generated by Tackle"
              }
            ]
          },
          "docs": "Gets more detailed information for a specific subscription"
        }
      ]
    }
  ],
  "bundled": true
}