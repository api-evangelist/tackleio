          "id": "f92c290a-54b1-49b0-8f84-60e5892eff99",
          "name": "Convert currencies",
          "request": {
            "name": "Convert currencies",
            "description": {
              "content": "Converts one or more amounts from a base currency to a target currency\nusing cached Microsoft foreign exchange rates. Row-level conversion\nerrors are returned in `results[].error` without failing the entire\nrequest.\n\nRequired RBAC action: `offers:CreateDraftOffer`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "currencies",
                "convert"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
