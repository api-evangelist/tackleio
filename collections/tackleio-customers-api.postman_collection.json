                  "raw": "{\n  \"companyName\": \"Example Corporation\",\n  \"address\": {\n    \"country\": \"<string>\",\n    \"addressLine1\": \"1 Example Way\",\n    \"city\": \"Redmond\",\n    \"state\": \"Washington\"\n  },\n  \"contact\": {\n    \"firstName\": \"<string>\",\n    \"lastName\": \"<string>\",\n    \"phoneNumber\": \"<string>\",\n    \"email\": \"<string>\",\n    \"title\": \"<string>\",\n    \"phoneValidationStatus\": \"None\",\n    \"emailValidationStatus\": \"None\"\n  },\n  \"crmCustomerUniqueID\": \"006QL00000BahjXXX\",\n  \"microsoftAccountId\": \"user@domain.com\",\n  \"bestMatchOnly\": false\n}",
