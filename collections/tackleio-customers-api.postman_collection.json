  "item": [
    {
      "id": "da63e153-2cd3-47e9-b93e-7c21ee3245e0",
      "name": "Customers",
      "description": {
        "content": "Look up customer accounts in Microsoft Partner Center before\ncreating a referral. Use these endpoints to determine\n`customerProfile.ids` and the `dealSensitivity` value\n(`USFed` vs `None`) you should send.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "673999a9-079d-443b-ac49-643968a5a2bb",
          "name": "Lookup customer info to determine if they are a US federal customer.",
          "request": {
            "name": "Lookup customer info to determine if they are a US federal customer.",
            "description": {
              "content": "Looks up the customer in Microsoft Partner Center by company\nname and reports whether Microsoft has tagged the account as a\nUS federal customer. Use this before creating a referral so\nyou can populate `dealSensitivity` correctly (`USFed` for US\nfederal customers, `None` otherwise). Returns an empty\n`customerInfo` array when no match is found.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "customerInfo"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
