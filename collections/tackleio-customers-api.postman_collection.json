        {
          "id": "9c164005-a3e3-403b-afdc-446324a50d30",
          "name": "Lookup customer details in Partner Center.",
          "request": {
            "name": "Lookup customer details in Partner Center.",
            "description": {
              "content": "Searches Microsoft Partner Center for matching customer\naccounts by company name plus country, returning managed,\nunmanaged, and Microsoft-account matches. Use this to populate\n`customerProfile.ids` and `customerProfile.address` on a\nsubsequent `createIPReferral` call. The full Partner Center\nlookup payload is accepted so callers can forward the same\nbody the Partner Center UI would, but only `companyName` and\n`address.country` materially affect matching; other fields\nare ignored.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "customerLookup"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"<string>\",\n  \"address\": {\n    \"country\": \"<string>\",\n    \"addressLine1\": \"<string>\",\n    \"city\": \"<string>\",\n    \"state\": \"<string>\"\n  },\n  \"contact\": {\n    \"firstName\": \"<string>\",\n    \"lastName\": \"<string>\",\n    \"phoneNumber\": \"<string>\",\n    \"email\": \"<string>\",\n    \"title\": \"<string>\",\n    \"phoneValidationStatus\": \"<string>\",\n    \"emailValidationStatus\": \"<string>\"\n  },\n  \"crmCustomerUniqueID\": \"<string>\",\n  \"microsoftAccountId\": \"<string>\",\n  \"bestMatchOnly\": \"<boolean>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
