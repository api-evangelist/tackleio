        {
          "id": "79c1324d-eb8b-425f-af8a-e85ade7a06a2",
          "name": "Get Product Pricing",
          "request": {
            "name": "Get Product Pricing",
            "description": {
              "content": "Returns the pricing dimensions, billing terms, and payment-model\ndefaults for an AWS Marketplace product. Use the response to\npre-populate a private-offer creation form with values that match the\nproduct's public listing.\n\n**Required RBAC permission:** `offers:CreateDraftOffer` (gated on the\ncreate permission because pricing is fetched as part of the\noffer-creation flow).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "products",
                ":productId",
                "pricing"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "productId",
                  "description": "(Required) The **AWS Marketplace Catalog API encrypted product identifier**.\n\nThis is **not** the Tackle product ID. Pass the\n`encrypted_productid` field from a product object returned by\n`GET /products`, or the `public_productid` field from an agreement\nreturned by `GET /agreements`. Passing the Tackle `productid` (or\n`id`) will return `404`.\n"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET"
          },
          "response": [
            {
              "id": "6b5f2149-c0b8-41bf-a43a-f902e3248868",
              "name": "Pricing for the product.",
              "originalRequest": {
                "url": {
                  "path": [
                    "products",
                    ":productId",
                    "pricing"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<string>",
                      "key": "productId",
                      "description": "(Required) The **AWS Marketplace Catalog API encrypted product identifier**.\n\nThis is **not** the Tackle product ID. Pass the\n`encrypted_productid` field from a product object returned by\n`GET /products`, or the `public_productid` field from an agreement\nreturned by `GET /agreements`. Passing the Tackle `productid` (or\n`id`) will return `404`.\n"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"show_on_email\": false,\n  \"duration\": \"string\",\n  \"marketplace_fee\": \"string\",\n  \"net_contract_value\": \"string\",\n  \"monthly_contract_value\": \"string\",\n  \"total_contract_value\": \"string\",\n  \"dimensions\": [\n    {\n      \"dimension_value\": \"string\",\n      \"name\": \"string\",\n      \"quantity\": \"string\",\n      \"price\": \"string\",\n      \"api_name\": \"string\",\n      \"aws_discount_percentage\": \"string\"\n    },\n    {\n      \"dimension_value\": \"string\",\n      \"name\": \"string\",\n      \"quantity\": \"string\",\n      \"price\": \"string\",\n      \"api_name\": \"string\",\n      \"aws_discount_percentage\": \"string\"\n    }\n  ],\n  \"usage_dimensions\": [\n    {\n      \"description\": \"string\",\n      \"sku\": \"string\",\n      \"price\": \"string\",\n      \"aws_discount_percentage\": \"string\"\n    },\n    {\n      \"description\": \"string\",\n      \"sku\": \"string\",\n      \"price\": \"string\",\n      \"aws_discount_percentage\": \"string\"\n    }\n  ],\n  \"units\": [\n    {\n      \"unit\": \"string\",\n      \"hourly_price\": \"string\",\n      \"duration_price\": \"string\"\n    },\n    {\n      \"unit\": \"string\",\n      \"hourly_price\": \"string\",\n      \"duration_price\": \"string\"\n    }\n  ],\n  \"currency_code\": \"DQD\",\n  \"version\": \"simple-pricing-v1-aws\",\n  \"schedule\": [\n    {\n      \"invoice_date\": \"1968-05-04\",\n      \"invoice_amount\": \"string\"\n    },\n    {\n      \"invoice_date\": \"2018-04-10\",\n      \"invoice_amount\": \"string\"\n    }\n  ],\n  \"payment_model\": \"one_time\",\n  \"billing_term\": \"3-years\",\n  \"duration_value\": 7838,\n  \"duration_type\": \"string\",\n  \"service_start_at\": \"1976-07-15\",\n  \"service_end_at\": \"2004-04-26\",\n  \"allow_auto_renew\": false\n}",
