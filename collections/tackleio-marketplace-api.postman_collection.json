        {
          "id": "a3912c46-ef57-482f-932f-d4093dbcef75",
          "name": "List AWS Marketplace Agreements",
          "request": {
            "name": "List AWS Marketplace Agreements",
            "description": {
              "content": "Returns the seller's AWS Marketplace agreements (entitlements). Used\nwhen assembling an amendment offer to discover an existing\nbuyer-seller agreement to amend.\n\nEach agreement carries a `public_productid` field which is the AWS\nencrypted product ID and can be passed as the `productId` path\nparameter to `GET /products/{productId}/pricing`.\n\n**Required RBAC permission:** `offers:CreateDraftOffer` (agreement\nlisting is gated on the create permission because it is part of the\noffer-creation flow).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "agreements"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "buyer_billing_account_ref",
                  "value": "<string>",
                  "description": "Filter to agreements for the given 12-digit AWS buyer account."
                },
                {
                  "disabled": false,
                  "key": "offerid",
                  "value": "<string>",
                  "description": "Filter to the agreement produced by the given marketplace offer ID."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "25",
                  "description": "Page size."
                },
                {
                  "disabled": false,
                  "key": "next_token",
                  "value": "<string>",
                  "description": "Opaque pagination cursor returned by a previous response."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET"
          },
          "response": [
