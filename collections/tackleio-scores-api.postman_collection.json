              "body": "{\n  \"data\": [\n    {\n      \"domain\": \"example.com\",\n      \"score_aws\": \"High\",\n      \"score_azure\": \"Medium\",\n      \"score_gcp\": \"Low\",\n      \"score_channel_partner\": \"\",\n      \"demographics\": {\n        \"country\": \"US\",\n        \"state\": \"California\",\n        \"employeeRange\": \"1001-5000\",\n        \"primaryIndustry\": \"Software\",\n        \"revenueRange\": \"$100M-$500M\",\n        \"region\": \"AMER\",\n        \"companyName\": \"Example Co\"\n      }\n    }\n  ],\n  \"metadata\": {\n    \"next_page\": \"1\",\n    \"previous_page\": \"\",\n    \"current_page_number\": 0,\n    \"current_page_record_count\": 1,\n    \"total_record_count\": 25,\n    \"search_after\": [\n      \"example.com\"\n    ]\n  }\n}",
