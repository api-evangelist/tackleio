        {
          "id": "57faa43a-f01c-4d7c-a846-04ebacaaa957",
          "name": "Search scored domains",
          "request": {
            "name": "Search scored domains",
            "description": {
              "content": "Searches scored domains using filters and pagination. When no\nfilters are supplied, the response contains all scored domains\navailable to the calling account, limited by pagination.\n\nPagination uses `page_number` and `records_per_page`. For large\nresult sets, use `metadata.search_after` from one response as the\nnext request's `search_after` value to continue forward.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "scores",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"page_number\": 0,\n  \"records_per_page\": 50,\n  \"search_after\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"domain_search_string\": \"<string>\",\n  \"domains\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"filtering_clouds\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"filtering_scores\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"regions\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"revenue_band\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"industries\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"new_high_scores\": \"<boolean>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
