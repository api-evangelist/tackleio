          "name": "Create an offer notification",
          "request": {
            "name": "Create an offer notification",
            "description": {
              "content": "Creates an offer notification. Currently only buyer instruction emails\nare supported. To send buyer instructions, use `type:\nbuyer_instructions` and `channel: email`. The handler publishes through\nTackle Notification Service and marks the offer as email sent.\n\nRequired RBAC action: `offers:SendOfferInstructions`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "private-offers",
                ":id",
                "notifications"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) Tackle private offer ID."
                }
